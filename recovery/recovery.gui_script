local passages = require("modules.passages")
local recovery_module = require("modules.recovery")
local gui_util = require("modules.gui_util")

local TOUCH = hash("touch")
local READING_TIME = 30
local current_passage = nil
local current_answers = nil
local timer_remaining = 0
local phase = "reading"
local answer_nodes = {}
local hero_hp = 0
local hero_max_hp = 100
local streak_count = 0
local healed_amount = 0
local last_displayed_sec = -1

-- Cached static nodes (resolved once in init).
local n_passage_bg, n_passage_text, n_timer_text, n_subject_tag, n_timer_bar_fill
local n_question_text, n_hint_text, n_feedback_text, n_hp_label

-- Reused buffer to avoid per-frame vmath.vector3 allocation in update().
local timer_bar_size = vmath.vector3(200, 6, 0)

-- Result-feedback colors (hoisted to avoid per-result allocation).
local C_BOX_CORRECT = vmath.vector4(0.1, 0.4, 0.18, 1)
local C_TXT_CORRECT = vmath.vector4(0.35, 1.0, 0.5, 1)
local C_BOX_WRONG   = vmath.vector4(0.4, 0.1, 0.1, 1)
local C_TXT_WRONG   = vmath.vector4(1.0, 0.5, 0.45, 1)
local C_BOX_DIM     = vmath.vector4(0.1, 0.1, 0.13, 0.4)
local C_TXT_DIM     = vmath.vector4(0.35, 0.35, 0.4, 0.4)
local C_FB_CORRECT  = vmath.vector4(0.35, 1.0, 0.5, 1)
local C_FB_ALMOST   = vmath.vector4(1.0, 0.85, 0.3, 1)
local C_FB_WRONG    = vmath.vector4(0.85, 0.5, 0.45, 1)
local C_ANSWER_BG   = vmath.vector4(0.14, 0.17, 0.24, 1)
local C_ANSWER_TXT  = vmath.vector4(0.85, 0.85, 0.92, 1)

local function pop(node)
	gui_util.pop(node)
end

local function destroy_answer_nodes()
	for _, n in ipairs(answer_nodes) do
		gui_util.safe_delete(n.box)
		gui_util.safe_delete(n.text)
	end
	answer_nodes = {}
end

local function show_question()
	phase = "question"

	gui.set_alpha(n_passage_bg, 0)
	gui.set_text(n_passage_text, "")
	gui.set_text(n_timer_text, "")
	gui.set_text(n_subject_tag, "")
	timer_bar_size.x = 200
	gui.set_size(n_timer_bar_fill, timer_bar_size)

	gui.set_text(n_question_text, current_passage.question)
	gui.set_alpha(n_question_text, 1)
	gui.set_text(n_hint_text, "Choose the best answer:")

	destroy_answer_nodes()
	current_answers = passages.build_answers(current_passage)

	for i, answer in ipairs(current_answers) do
		local x = 640
		local y = 500 - i * 65
		local box = gui.new_box_node(vmath.vector3(x, y, 0), vmath.vector3(750, 52, 0))
		gui.set_color(box, C_ANSWER_BG)

		local label = string.char(64 + i) .. ".  " .. answer.text
		local txt = gui.new_text_node(vmath.vector3(x - 340, y, 0), label)
		gui.set_font(txt, "reading_font")
		gui.set_pivot(txt, gui.PIVOT_W)
		gui.set_scale(txt, vmath.vector3(0.85, 0.85, 1))
		gui.set_color(txt, C_ANSWER_TXT)

		-- Staggered pop-in
		gui.set_scale(box, vmath.vector3(0.8, 0, 1))
		gui.animate(box, gui.PROP_SCALE, vmath.vector3(1, 1, 1), gui.EASING_OUTBACK, 0.3, i * 0.08)
		gui.set_alpha(txt, 0)
		gui.animate(txt, "color.w", 1, gui.EASING_OUTQUAD, 0.2, i * 0.08 + 0.1)

		answer_nodes[i] = {box = box, text = txt, quality = answer.quality}
	end
end

local function show_result(answer_quality)
	phase = "result"

	local max_recovery = hero_max_hp - hero_hp
	local healed, feedback = recovery_module.calculate(max_recovery, answer_quality, streak_count)

	if answer_quality == "correct" or answer_quality == "almost_right" then
		streak_count = streak_count + 1
	else
		streak_count = 0
	end

	for _, n in ipairs(answer_nodes) do
		if n.quality == "correct" then
			gui.set_color(n.box, C_BOX_CORRECT)
			gui.set_color(n.text, C_TXT_CORRECT)
			pop(n.box)
		elseif n.quality == answer_quality and answer_quality ~= "correct" then
			gui.set_color(n.box, C_BOX_WRONG)
			gui.set_color(n.text, C_TXT_WRONG)
		else
			gui.set_color(n.box, C_BOX_DIM)
			gui.set_color(n.text, C_TXT_DIM)
		end
	end

	-- Better messaging when at full HP
	local feedback_msg
	if max_recovery <= 0 then
		feedback_msg = "Already at full health!"
	else
		feedback_msg = feedback .. "  +" .. healed .. " HP"
	end

	gui.set_text(n_feedback_text, feedback_msg)
	gui.set_alpha(n_feedback_text, 1.0)

	if answer_quality == "correct" then
		gui.set_color(n_feedback_text, C_FB_CORRECT)
	elseif answer_quality == "almost_right" then
		gui.set_color(n_feedback_text, C_FB_ALMOST)
	else
		gui.set_color(n_feedback_text, C_FB_WRONG)
	end

	gui.set_text(n_hint_text, "Tap anywhere to continue")
	gui.set_text(n_question_text, "")

	healed_amount = healed
end

function init(self)
	msg.post(".", "acquire_input_focus")
	phase = "reading"
	timer_remaining = READING_TIME
	streak_count = 0
	healed_amount = 0
	current_passage = nil
	current_answers = nil
	last_displayed_sec = -1

	n_passage_bg     = gui.get_node("passage_bg")
	n_passage_text   = gui.get_node("passage_text")
	n_timer_text     = gui.get_node("timer_text")
	n_subject_tag    = gui.get_node("subject_tag")
	n_timer_bar_fill = gui.get_node("timer_bar_fill")
	n_question_text  = gui.get_node("question_text")
	n_hint_text      = gui.get_node("hint_text")
	n_feedback_text  = gui.get_node("feedback_text")
	n_hp_label       = gui.get_node("hp_label")

	destroy_answer_nodes()
end

function on_message(self, message_id, message, sender)
	if message_id == hash("setup") then
		hero_hp = message.hero_hp or 50
		hero_max_hp = message.hero_max_hp or 100
		gui.set_text(n_hp_label, "HP: " .. hero_hp)

		current_passage = passages.get_random(1, 5)
		gui.set_alpha(n_passage_bg, 1)
		gui.set_text(n_passage_text, current_passage.text)
		gui.set_text(n_subject_tag, (current_passage.subject or ""):upper())
		gui.set_text(n_question_text, "")
		gui.set_text(n_feedback_text, "")
		gui.set_alpha(n_feedback_text, 0)
		gui.set_text(n_hint_text, "Read carefully... A question will appear when the timer ends.")

		phase = "reading"
		timer_remaining = READING_TIME
		streak_count = 0
	end
end

function update(self, dt)
	if phase == "reading" then
		timer_remaining = timer_remaining - dt
		if timer_remaining <= 0 then
			timer_remaining = 0
			show_question()
			return
		end

		local ceil_sec = math.ceil(timer_remaining)
		if ceil_sec ~= last_displayed_sec then
			last_displayed_sec = ceil_sec
			local mins = math.floor(ceil_sec / 60)
			local secs = ceil_sec % 60
			gui.set_text(n_timer_text, string.format("%d:%02d", mins, secs))
		end

		local progress = 1 - (timer_remaining / READING_TIME)
		timer_bar_size.x = 200 * progress
		gui.set_size(n_timer_bar_fill, timer_bar_size)
	end
end

function on_input(self, action_id, action)
	if action_id ~= TOUCH or not action.pressed then
		return false
	end

	if phase == "question" then
		for _, n in ipairs(answer_nodes) do
			if gui.pick_node(n.box, action.x, action.y) then
				pop(n.box)
				show_result(n.quality)
				return true
			end
		end
	elseif phase == "result" then
		destroy_answer_nodes()
		msg.post("main:/controller#script", "recovery_done", {healed = healed_amount or 0})
		return true
	end

	return false
end
