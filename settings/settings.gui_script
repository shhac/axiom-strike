local gui_util = require("modules.gui_util")

local READING_LEVELS = {"AUTO", "Grade 1", "Grade 2", "Grade 3", "Grade 4", "Grade 5", "Grade 6", "Grade 7"}

local TOUCH = hash("touch")

local COLOR_ON  = vmath.vector4(0.267, 0.8, 0.4, 1)
local COLOR_OFF = vmath.vector4(0.267, 0.2, 0.333, 1)
local TEXT_ON   = vmath.vector4(1, 1, 1, 1)
local TEXT_OFF  = vmath.vector4(0.6, 0.533, 0.6, 1)

local n_btn_sound, n_btn_sound_text
local n_btn_tp,    n_btn_tp_text
local n_btn_tp2,   n_btn_tp2_text
local n_btn_reading, n_btn_reading_text
local n_btn_back

local function set_toggle(btn, text, is_on)
	gui.set_color(btn,  is_on and COLOR_ON or COLOR_OFF)
	gui.set_text(text,  is_on and "ON" or "OFF")
	gui.set_color(text, is_on and TEXT_ON or TEXT_OFF)
end

local function update_reading_display(self)
	gui.set_text(n_btn_reading_text, READING_LEVELS[self.reading_level_index])
end

function init(self)
	msg.post(".", "acquire_input_focus")

	n_btn_sound        = gui.get_node("btn_sound")
	n_btn_sound_text   = gui.get_node("btn_sound_text")
	n_btn_tp           = gui.get_node("btn_time_pressure")
	n_btn_tp_text      = gui.get_node("btn_time_pressure_text")
	n_btn_tp2          = gui.get_node("btn_tile_persist")
	n_btn_tp2_text     = gui.get_node("btn_tile_persist_text")
	n_btn_reading      = gui.get_node("btn_reading")
	n_btn_reading_text = gui.get_node("btn_reading_text")
	n_btn_back         = gui.get_node("btn_back")

	-- Load settings or use defaults
	local saved = sys.load(sys.get_save_file("axiom_strike", "settings"))
	self.sound_on = saved.sound_on ~= false
	self.time_pressure = saved.time_pressure or false
	self.tile_persist = saved.tile_persist or false
	self.reading_level_index = saved.reading_level_index or 1

	set_toggle(n_btn_sound, n_btn_sound_text, self.sound_on)
	set_toggle(n_btn_tp,    n_btn_tp_text,    self.time_pressure)
	set_toggle(n_btn_tp2,   n_btn_tp2_text,   self.tile_persist)
	update_reading_display(self)
end

local function save_settings(self)
	sys.save(sys.get_save_file("axiom_strike", "settings"), {
		sound_on = self.sound_on,
		time_pressure = self.time_pressure,
		tile_persist = self.tile_persist,
		reading_level_index = self.reading_level_index,
	})
end

local function pop(node)
	gui_util.pop(node)
end

function on_input(self, action_id, action)
	if action_id ~= TOUCH or not action.pressed then
		return false
	end

	if gui.pick_node(n_btn_sound, action.x, action.y) then
		pop(n_btn_sound)
		self.sound_on = not self.sound_on
		set_toggle(n_btn_sound, n_btn_sound_text, self.sound_on)
		save_settings(self)
		return true
	end

	if gui.pick_node(n_btn_tp, action.x, action.y) then
		pop(n_btn_tp)
		self.time_pressure = not self.time_pressure
		set_toggle(n_btn_tp, n_btn_tp_text, self.time_pressure)
		save_settings(self)
		return true
	end

	if gui.pick_node(n_btn_tp2, action.x, action.y) then
		pop(n_btn_tp2)
		self.tile_persist = not self.tile_persist
		set_toggle(n_btn_tp2, n_btn_tp2_text, self.tile_persist)
		save_settings(self)
		return true
	end

	if gui.pick_node(n_btn_reading, action.x, action.y) then
		pop(n_btn_reading)
		self.reading_level_index = (self.reading_level_index % #READING_LEVELS) + 1
		update_reading_display(self)
		save_settings(self)
		return true
	end

	if gui.pick_node(n_btn_back, action.x, action.y) then
		pop(n_btn_back)
		msg.post("main:/controller#script", "back_to_menu")
		return true
	end

	return false
end
